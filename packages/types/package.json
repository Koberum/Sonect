{
  "name": "@repo/types",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./system": {
      "types": "./dist/system/types.d.ts",
      "default": "./dist/system/types.js"
    },
    "./library": {
      "types": "./dist/library/types.d.ts",
      "default": "./dist/library/types.js"
    },
    "./player": {
      "types": "./dist/player/types.d.ts",
      "default": "./dist/player/types.js"
    },
    "./cover": {
      "types": "./dist/cover/types.d.ts",
      "default": "./dist/cover/types.js"
    },
    "./storage": {
      "types": "./dist/storage/types.d.ts",
      "default": "./dist/storage/types.js"
    },
    "./network": {
      "types": "./dist/network/types.d.ts",
      "default": "./dist/network/types.js"
    },
    "./mpd": {
      "types": "./dist/mpd/types.d.ts",
      "default": "./dist/mpd/types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/typescript6": "6.0.2",
    "eslint": "^10.10.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
