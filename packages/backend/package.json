{
  "name": "backend",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/bundle.cjs",
    "build": "tsc",
    "bundle": "esbuild src/server.ts --bundle --platform=node --outfile=dist/bundle.cjs --external:sharp --external:dotenv --banner:js=\"const SONECT_BUNDLE_URL=require('url').pathToFileURL(__dirname+'/drizzle/anchor').href;\" --define:import.meta.url=SONECT_BUNDLE_URL && rm -rf dist/drizzle && cp -r ../db/drizzle dist/drizzle",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:coverage": "c8 --all --src=src --include='src/**/*.ts' --exclude='src/__tests__/**' --exclude='src/**/*.d.ts' --exclude-after-remap --reporter=text --reporter=lcov node --import=tsx/esm ./node_modules/mocha/bin/mocha.js --no-config --timeout=10000 'src/__tests__/**/*.test.ts'",
    "lint": "eslint ."
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/types": "workspace:*",
    "dotenv": "^18.0.7",
    "express": "5.3.0",
    "mpd": "1.3.0",
    "music-metadata": "^12.2.0",
    "sharp": "^0.35.5",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/typescript6": "6.0.2",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "drizzle-orm": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
