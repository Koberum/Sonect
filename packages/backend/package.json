{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/bundle.cjs",
    "build": "tsc",
    "bundle": "esbuild src/server.ts --bundle --platform=node --outfile=dist/bundle.cjs --external:sharp --external:dotenv && cp ../db/node_modules/sql.js/dist/sql-wasm.wasm dist/",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:coverage": "c8 --reporter=text --reporter=lcov pnpm test",
    "sync": "tsx src/scripts/sync.ts"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/types": "workspace:*",
    "dotenv": "^17.2.4",
    "express": "5.2.1",
    "mpd": "1.3.0",
    "music-metadata": "^11.12.0",
    "sharp": "^0.34.5",
    "ws": "8.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.1",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.0",
    "@types/sinon": "^17.0.4",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "esbuild": "^0.25.3",
    "esmock": "^2.7.0",
    "mocha": "^11.1.0",
    "sinon": "^19.0.4",
    "supertest": "^7.1.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
