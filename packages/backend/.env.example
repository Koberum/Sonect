# MPD connection
MPD_HOST=localhost
MPD_PORT=6600
MPD_CONFIG_PATH=/opt/sonect/data/mpd-audio.conf

# Absolute path to the MPD music directory (used for cover extraction)
MUSIC_DIR=/opt/sonect/music

# Comma-separated audio extensions counted as music files in per-source library stats
MUSIC_EXTENSIONS=mp3,flac,ogg,oga,opus,m4a,aac,wav,wma,ape,wv,dsf,dff,mpc,tta

# Absolute path to the directory where extracted album artwork is stored
COVERS_DIR=/workspace/data/covers

# Path to the SQLite database file. Set it explicitly per environment:
# dev container /db/music.db (persistent volume, shared with db:* scripts),
# production /opt/sonect/data/music.db (set by the installer via systemd).
# The ./data/music.db relative fallback is throwaway-only: it resolves per
# process cwd, so processes can silently open different files.
# DB_PATH=/db/music.db

# Path to the MPD user-editable config drop-in (default: /opt/sonect/data/mpd-audio.conf)
# This file is included by /etc/mpd.conf via the `include` directive.
# MPD_CONFIG_PATH=/opt/sonect/data/mpd-audio.conf

# HTTP port for the backend API (default: 3000)
PORT=3000

# Host resolved to verify DNS connectivity (default: example.com)
DNS_CHECK_HOST=example.com

# Production-only: set by systemd unit in production, uncomment for manual runs
# NODE_ENV=production
# FRONTEND_DIST=../frontend/dist
