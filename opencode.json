{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "instructions": ["AGENTS.md"],
  "formatter": true,
  "lsp": true,
  "command": {
    "dev": {
      "template": "Run pnpm dev to start all development servers in parallel (backend on :3000, frontend on :5173).",
      "description": "Start all dev servers (backend + frontend)"
    },
    "build": {
      "template": "Run pnpm build to compile all workspace packages with tsc.",
      "description": "Build all packages"
    },
    "lint": {
      "template": "Run pnpm lint to lint all packages with ESLint.",
      "description": "Lint all packages"
    },
    "test": {
      "template": "Run pnpm backend:test to execute the backend test suite (Mocha/Chai/Sinon/Supertest). Use pnpm backend:test:watch for watch mode.",
      "description": "Run backend tests"
    }
  },
  "agent": {
    "backend": {
      "description": "Specialist for backend (Express/MPD/WebSocket) work",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/backend.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "frontend": {
      "description": "Specialist for frontend (React/UI/components) work",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/frontend.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "shadcn@latest", "mcp"]
    }
  }
}
